# Copy to .env and fill in. Never commit .env.
# Agent / parser LLM (OpenAI-compatible API first per Weeks 1-2 plan)
OPENAI_API_KEY=
# Per-role endpoint overrides (Phase 6 second-backbone pilot). CLI flags win over these.
# Agent role: AGENT_BASE_URL, else legacy QWEN_BASE_URL; parser role: PARSER_BASE_URL only
# (parser stays on the default endpoint unless explicitly overridden, isolating the variable).
AGENT_BASE_URL=
AGENT_API_KEY=
PARSER_BASE_URL=
PARSER_API_KEY=
# Legacy Qwen / other OpenAI-compatible endpoint (fallback for the agent role only)
QWEN_API_KEY=
QWEN_BASE_URL=
# Model IDs (pin exact versions in results logs)
AGENT_MODEL_ID=gpt-4o-mini
PARSER_MODEL_ID=gpt-4o-mini
# Embedding model (CPU, pinned)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
